@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<div class="event-order-container">
    <div class="event-order-header">
        <h1 class="event-order-title">Create Event Order</h1>
        <p class="event-order-subtitle">Step @(CurrentStep + 1) of 5</p>
    </div>

    <!-- Progress Bar -->
    <div class="progress-wrapper">
        <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-gradient" role="progressbar" style="width: @((CurrentStep + 1) * 20)%"
                 aria-valuenow="@(CurrentStep + 1)" aria-valuemin="1" aria-valuemax="5"></div>
        </div>
        <div class="step-indicators">
            <div class="step-indicator @(CurrentStep >= 0 ? "active" : "")">1</div>
            <div class="step-indicator @(CurrentStep >= 1 ? "active" : "")">2</div>
            <div class="step-indicator @(CurrentStep >= 2 ? "active" : "")">3</div>
            <div class="step-indicator @(CurrentStep >= 3 ? "active" : "")">4</div>
            <div class="step-indicator @(CurrentStep >= 4 ? "active" : "")">5</div>
        </div>
    </div>

    <!-- Step 1: Select Person -->
    <div class="step-content @(CurrentStep == 0 ? "active" : "")" style="display: @(CurrentStep == 0 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">👤</div>
                <h3>Who is organizing this event?</h3>
            </div>
            <div class="step-card-body">
                <div class="person-grid">
                    @foreach (var person in _model.AvailablePersons)
                    {
                        <div class="person-card @(_model.SelectedPersonId == person.Id ? "selected" : "")"
                             @onclick="() => SelectPerson(person)">
                            <div class="person-card-content">
                                <h5>@person.FullName</h5>
                                <small class="text-muted">CNP: @person.CNP</small>
                            </div>
                            @if (_model.SelectedPersonId == person.Id)
                            {
                                <div class="check-badge">✓</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Event Details -->
    <div class="step-content @(CurrentStep == 1 ? "active" : "")" style="display: @(CurrentStep == 1 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">📅</div>
                <h3>Event Details</h3>
            </div>
            <div class="step-card-body">
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Event Name</label>
                    <InputText class="form-control form-control-lg" @bind-value="_model.EventName" 
                               placeholder="Enter event name (e.g., Summer Wedding, Birthday Party)" />
                    @if (string.IsNullOrWhiteSpace(_model.EventName))
                    {
                        <div class="text-danger small mt-2">Event name is required</div>
                    }
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Event Type</label>
                    <InputSelect class="form-control form-control-lg" @bind-value="_model.EventType">
                        <option value="0">Select an event type...</option>
                        <option value="1">Wedding</option>
                        <option value="2">Birthday</option>
                        <option value="3">Teambuilding</option>
                        <option value="4">Festival</option>
                    </InputSelect>
                    @if (_model.EventType == 0)
                    {
                        <div class="text-danger small mt-2">Event type is required</div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label fw-bold">Event Date</label>
                    <InputText type="date" class="form-control form-control-lg" @bind-value="_model.EventDate" />
                    @if (string.IsNullOrWhiteSpace(_model.EventDate))
                    {
                        <div class="text-danger small mt-2">Event date is required</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Select Location/Venue -->
    <div class="step-content @(CurrentStep == 2 ? "active" : "")" style="display: @(CurrentStep == 2 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">🏛️</div>
                <h3>Choose Your Venue</h3>
            </div>
            <div class="step-card-body">
                <div class="location-grid">
                    @foreach (var location in _model.AvailableLocations)
                    {
                        <div class="location-card @(_model.SelectedLocationId == location.Id ? "selected" : "")"
                             @onclick="() => SelectLocation(location)">
                            <div class="location-card-inner">
                                <h5 class="location-name">@location.Name</h5>
                                <p class="location-company">@location.CompanyName</p>
                                @if (!string.IsNullOrEmpty(location.Description))
                                {
                                    <p class="location-description">@location.Description</p>
                                }
                                <div class="location-price">
                                    <span class="price-value">@location.Price.ToString("N0")</span>
                                    <span class="price-currency">RON</span>
                                </div>
                            </div>
                            @if (_model.SelectedLocationId == location.Id)
                            {
                                <div class="check-badge-large">✓</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 4: Select Products (Grouped by Type) -->
    <div class="step-content @(CurrentStep == 3 ? "active" : "")" style="display: @(CurrentStep == 3 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">🎁</div>
                <h3>Select Services & Products</h3>
            </div>
            <div class="step-card-body">
                <div class="products-by-type">
                    @foreach (var group in _productGroups)
                    {
                        <div class="product-category">
                            <div class="category-header" @onclick="() => ToggleCategoryExpanded(group.TypeName)">
                                <div class="category-toggle">
                                    <i class="bi @(_expandedCategories.Contains(group.TypeName) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </div>
                                <div class="category-info">
                                    <h5 class="category-title">@group.TypeName</h5>
                                    <small class="text-muted">@group.Count items</small>
                                </div>
                            </div>
                            
                            @if (_expandedCategories.Contains(group.TypeName))
                            {
                                <div class="category-products">
                                    @foreach (var product in group.Products)
                                    {
                                        <div class="product-item">
                                            <div class="product-info">
                                                <h6 class="product-name">@product.Name</h6>
                                                @if (!string.IsNullOrEmpty(product.Description))
                                                {
                                                    <p class="product-description">@product.Description</p>
                                                }
                                                <div class="product-price">
                                                    <span class="price-badge">@product.Price.ToString("N0") RON</span>
                                                </div>
                                            </div>
                                            <div class="product-actions">
                                                @if (IsProductSelected(product.Id))
                                                {
                                                    <div class="product-quantity-input">
                                                        <button class="btn-qty" @onclick="() => DecreaseQuantity(product.Id)">−</button>
                                                        <input type="number" class="qty-value" 
                                                               value="@GetSelectedProductQuantity(product.Id)" 
                                                               @onchange="@((ChangeEventArgs e) => UpdateQuantity(product.Id, e.Value))"
                                                               min="1" />
                                                        <button class="btn-qty" @onclick="() => IncreaseQuantity(product.Id)">+</button>
                                                    </div>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveProduct(product.Id)">
                                                        Remove
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary btn-add" @onclick="() => AddProduct(product)">
                                                        <i class="bi bi-plus-circle"></i> Add
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (_model.SelectedProducts.Count > 0)
                {
                    <div class="selected-products-summary mt-4">
                        <h6>Selected Items (@_model.SelectedProducts.Count)</h6>
                        <div class="summary-table">
                            @foreach (var product in _model.SelectedProducts)
                            {
                                <div class="summary-row">
                                    <span class="summary-name">@product.ProductName</span>
                                    <span class="summary-qty">x @product.Quantity</span>
                                    <span class="summary-price">@product.TotalPrice.ToString("N0") RON</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Step 5: Review and Confirm -->
    <div class="step-content @(CurrentStep == 4 ? "active" : "")" style="display: @(CurrentStep == 4 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">✓</div>
                <h3>Review Your Order</h3>
            </div>
            <div class="step-card-body">
                <div class="review-section">
                    <h6 class="review-section-title">Organizer</h6>
                    <p class="review-value">@((_selectedPerson?.FirstName ?? "") + " " + (_selectedPerson?.LastName ?? ""))</p>
                    <small class="text-muted">CNP: @(_selectedPerson?.CNP ?? "Not selected")</small>
                </div>

                <div class="review-section">
                    <h6 class="review-section-title">Event</h6>
                    <p class="review-value">@(_model.EventName ?? "Not specified")</p>
                    <small class="text-muted">Date: @(_model.EventDate ?? "Not specified")</small>
                </div>

                <div class="review-section">
                    <h6 class="review-section-title">Venue</h6>
                    <p class="review-value">@(_selectedLocation?.Name ?? "Not selected")</p>
                    @if (_selectedLocation != null)
                    {
                        <small class="text-muted">@_selectedLocation.Price.ToString("N0") RON</small>
                    }
                </div>

                @if (_model.SelectedProducts.Count > 0)
                {
                    <div class="review-section">
                        <h6 class="review-section-title">Services & Products</h6>
                        <div class="review-products">
                            @foreach (var product in _model.SelectedProducts)
                            {
                                <div class="review-product-item">
                                    <span>@product.ProductName</span>
                                    <span>x @product.Quantity</span>
                                    <span class="fw-bold">@product.TotalPrice.ToString("N0") RON</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="order-total">
                    <span class="total-label">Order Total:</span>
                    <span class="total-amount">@_model.TotalPrice.ToString("N0") RON</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="navigation-buttons">
        <button class="btn btn-outline-secondary btn-lg" @onclick="PreviousStep" disabled="@(CurrentStep == 0)">
            <i class="bi bi-arrow-left"></i> Previous
        </button>
        
        @if (CurrentStep < 4)
        {
            <button class="btn btn-primary btn-lg" @onclick="NextStep" disabled="@(!CanProceedToNext())">
                Next <i class="bi bi-arrow-right"></i>
            </button>
        }
        else
        {
            <button class="btn btn-success btn-lg" @onclick="SubmitOrder" disabled="@(_isSubmitting)">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Creating Order</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle"></i> Create Order</span>
                }
            </button>
        }
    </div>
</div>

<style>
    .event-order-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .event-order-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .event-order-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .event-order-subtitle {
        font-size: 1rem;
        color: #7f8c8d;
        margin: 0;
    }

    .progress-wrapper {
        margin-bottom: 40px;
    }

    .bg-gradient {
        background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 100%);
    }

    .step-indicators {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        gap: 10px;
    }

    .step-indicator {
        flex: 1;
        height: 50px;
        border-radius: 50%;
        background: #ecf0f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #7f8c8d;
        border: 2px solid #bdc3c7;
        transition: all 0.3s ease;
    }

    .step-indicator.active {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        border-color: #6366f1;
    }

    .step-content {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .step-content.active {
        opacity: 1;
    }

    .step-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-bottom: 30px;
    }

    .step-card-header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .step-icon {
        font-size: 2.5rem;
    }

    .step-card-header h3 {
        margin: 0;
        font-size: 1.5rem;
    }

    .step-card-body {
        padding: 30px;
    }

    /* Person Selection */
    .person-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
    }

    .person-card {
        border: 2px solid #ecf0f1;
        border-radius: 10px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        background: white;
    }

    .person-card:hover {
        border-color: #6366f1;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
        transform: translateY(-4px);
    }

    .person-card.selected {
        border-color: #6366f1;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .person-card h5 {
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .check-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    /* Location Selection */
    .location-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .location-card {
        border: 2px solid #ecf0f1;
        border-radius: 12px;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        background: white;
    }

    .location-card:hover {
        border-color: #6366f1;
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.15);
        transform: translateY(-6px);
    }

    .location-card.selected {
        border-color: #6366f1;
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
    }

    .location-card-inner {
        padding: 20px;
    }

    .location-name {
        margin: 0 0 8px 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .location-company {
        margin: 0 0 8px 0;
        font-size: 0.9rem;
        color: #7f8c8d;
    }

    .location-description {
        margin: 8px 0;
        font-size: 0.85rem;
        color: #95a5a6;
    }

    .location-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #ecf0f1;
    }

    .price-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #6366f1;
    }

    .price-currency {
        font-size: 0.9rem;
        color: #7f8c8d;
    }

    .check-badge-large {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.3rem;
    }

    /* Product Categories */
    .products-by-type {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .product-category {
        border: 1px solid #ecf0f1;
        border-radius: 10px;
        overflow: hidden;
    }

    .category-header {
        background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        padding: 16px 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
        user-select: none;
    }

    .category-header:hover {
        background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
    }

    .category-toggle {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
        transition: transform 0.3s ease;
    }

    .category-info {
        flex: 1;
    }

    .category-title {
        margin: 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .category-products {
        padding: 20px;
        background: white;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .product-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 15px;
        background: #f9fafb;
        border-radius: 8px;
        border-left: 4px solid #6366f1;
        transition: all 0.3s ease;
    }

    .product-item:hover {
        background: #f3f4f6;
    }

    .product-info {
        flex: 1;
    }

    .product-name {
        margin: 0 0 6px 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .product-description {
        margin: 0 0 8px 0;
        font-size: 0.85rem;
        color: #7f8c8d;
    }

    .product-price {
        margin-top: 8px;
    }

    .price-badge {
        display: inline-block;
        background: #6366f1;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .product-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .product-quantity-input {
        display: flex;
        align-items: center;
        border: 1px solid #bdc3c7;
        border-radius: 6px;
        background: white;
        overflow: hidden;
    }

    .btn-qty {
        width: 32px;
        height: 32px;
        border: none;
        background: #ecf0f1;
        color: #2c3e50;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.2s ease;
    }

    .btn-qty:hover {
        background: #d5dbdb;
    }

    .qty-value {
        width: 40px;
        text-align: center;
        border: none;
        background: white;
        font-weight: bold;
        color: #2c3e50;
    }

    .qty-value::-webkit-outer-spin-button,
    .qty-value::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .btn-add {
        white-space: nowrap;
        font-weight: 600;
    }

    .selected-products-summary {
        background: #f9fafb;
        border-radius: 10px;
        padding: 20px;
        border-left: 4px solid #10b981;
    }

    .selected-products-summary h6 {
        margin-bottom: 15px;
        color: #2c3e50;
    }

    .summary-table {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #ecf0f1;
        font-size: 0.95rem;
    }

    .summary-row:last-child {
        border-bottom: none;
    }

    .summary-name {
        flex: 1;
        color: #2c3e50;
        font-weight: 500;
    }

    .summary-qty {
        color: #7f8c8d;
        min-width: 50px;
        text-align: right;
    }

    .summary-price {
        color: #6366f1;
        font-weight: 600;
        min-width: 100px;
        text-align: right;
    }

    /* Review Section */
    .review-section {
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #ecf0f1;
    }

    .review-section:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .review-section-title {
        color: #7f8c8d;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .review-value {
        margin: 0;
        font-size: 1.1rem;
        color: #2c3e50;
        font-weight: 600;
    }

    .review-products {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .review-product-item {
        display: flex;
        justify-content: space-between;
        padding: 12px;
        background: #f9fafb;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .order-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        padding: 20px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        border-radius: 10px;
        color: white;
    }

    .total-label {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .total-amount {
        font-size: 2rem;
        font-weight: 700;
    }

    /* Navigation */
    .navigation-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .btn-lg {
        padding: 12px 40px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    }

    .btn-success:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .form-control-lg {
        font-size: 1rem;
        padding: 12px 15px;
        border-radius: 8px;
        border: 2px solid #ecf0f1;
        transition: all 0.3s ease;
    }

    .form-control-lg:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15);
