@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<div class="event-order-container">
    <div class="event-order-header">
        <h1 class="event-order-title">Create Event Order</h1>
        <p class="event-order-subtitle">Step @(CurrentStep + 1) of 5</p>
    </div>

    <!-- Progress Bar -->
    <div class="progress-wrapper">
        <div class="stepper-container">
            <div class="stepper-steps">
                <div class="step @(CurrentStep >= 0 ? "active" : "") @(CurrentStep > 0 ? "completed" : "")">
                    <div class="step-circle">
                        @if (CurrentStep > 0)
                        {
                            <span class="step-icon">✓</span>
                        }
                        else
                        {
                            <span>1</span>
                        }
                    </div>
                    <div class="step-label">Person</div>
                </div>

                <div class="step-connector @(CurrentStep >= 1 ? "completed" : "")"></div>

                <div class="step @(CurrentStep >= 1 ? "active" : "") @(CurrentStep > 1 ? "completed" : "")">
                    <div class="step-circle">
                        @if (CurrentStep > 1)
                        {
                            <span class="step-icon">✓</span>
                        }
                        else
                        {
                            <span>2</span>
                        }
                    </div>
                    <div class="step-label">Event</div>
                </div>

                <div class="step-connector @(CurrentStep >= 2 ? "completed" : "")"></div>

                <div class="step @(CurrentStep >= 2 ? "active" : "") @(CurrentStep > 2 ? "completed" : "")">
                    <div class="step-circle">
                        @if (CurrentStep > 2)
                        {
                            <span class="step-icon">✓</span>
                        }
                        else
                        {
                            <span>3</span>
                        }
                    </div>
                    <div class="step-label">Venue</div>
                </div>

                <div class="step-connector @(CurrentStep >= 3 ? "completed" : "")"></div>

                <div class="step @(CurrentStep >= 3 ? "active" : "") @(CurrentStep > 3 ? "completed" : "")">
                    <div class="step-circle">
                        @if (CurrentStep > 3)
                        {
                            <span class="step-icon">✓</span>
                        }
                        else
                        {
                            <span>4</span>
                        }
                    </div>
                    <div class="step-label">Services</div>
                </div>

                <div class="step-connector @(CurrentStep >= 4 ? "completed" : "")"></div>

                <div class="step @(CurrentStep >= 4 ? "active" : "")">
                    <div class="step-circle">
                        <span>5</span>
                    </div>
                    <div class="step-label">Review</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 1: Select Person -->
    <div class="step-content @(CurrentStep == 0 ? "active" : "")" style="display: @(CurrentStep == 0 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">👤</div>
                <h3>Who is organizing this event?</h3>
            </div>
            <div class="step-card-body">
                <div class="person-grid">
                    @foreach (var person in _model.AvailablePersons)
                    {
                        <div class="person-card @(_model.SelectedPersonId == person.Id ? "selected" : "")"
                             @onclick="() => SelectPerson(person)">
                            <div class="person-card-content">
                                <h5>@person.FullName</h5>
                                <small class="text-muted">CNP: @person.CNP</small>
                            </div>
                            @if (_model.SelectedPersonId == person.Id)
                            {
                                <div class="check-badge">✓</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Event Details -->
    <div class="step-content @(CurrentStep == 1 ? "active" : "")" style="display: @(CurrentStep == 1 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">📅</div>
                <h3>Event Details</h3>
            </div>
            <div class="step-card-body">
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Event Name</label>
                    <InputText class="form-control form-control-lg" @bind-value="_model.EventName" 
                               placeholder="Enter event name (e.g., Summer Wedding, Birthday Party)" />
                    @if (string.IsNullOrWhiteSpace(_model.EventName))
                    {
                        <div class="text-danger small mt-2">Event name is required</div>
                    }
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Event Type</label>
                    <InputSelect class="form-control form-control-lg" @bind-value="_model.EventType">
                        <option value="0">Select an event type...</option>
                        <option value="1">Wedding</option>
                        <option value="2">Birthday</option>
                        <option value="3">Teambuilding</option>
                        <option value="4">Festival</option>
                        <option value="5">Other</option>
                        <option value="6">Meeting</option>
                        <option value="7">Party</option>
                        <option value="8">Community</option>
                        <option value="9">Conference</option>
                        <option value="10">Gala</option>
                        <option value="11">Product Launch</option>
                        <option value="12">Baby Shower</option>
                    </InputSelect>
                    @if (_model.EventType == 0)
                    {
                        <div class="text-danger small mt-2">Event type is required</div>
                    }
                </div>

                <div class="form-group event-date-field">
                    <label class="form-label fw-bold">Event Date</label>
                    <DatePickerField @bind-Value="_model.EventDate"
                                     Placeholder="Choose event date"
                                     CssClass="form-control-lg" />
                    @if (string.IsNullOrWhiteSpace(_model.EventDate))
                    {
                        <div class="text-danger small mt-2">Event date is required</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3: Select Location/Venue -->
    <div class="step-content @(CurrentStep == 2 ? "active" : "")" style="display: @(CurrentStep == 2 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">🏛️</div>
                <h3>Choose Your Venue</h3>
            </div>
            <div class="step-card-body">
                <div class="location-grid">
                    @foreach (var location in _model.AvailableLocations)
                    {
                        <div class="location-card @(_model.SelectedLocationId == location.Id ? "selected" : "")"
                             @onclick="() => SelectLocation(location)">
                            <div class="location-card-inner">
                                <h5 class="location-name">@location.Name</h5>
                                <p class="location-company">@location.CompanyName</p>
                                @if (!string.IsNullOrEmpty(location.Description))
                                {
                                    <p class="location-description">@location.Description</p>
                                }
                                <div class="location-price">
                                    <span class="price-value">@location.Price.ToString("N0")</span>
                                    <span class="price-currency">RON</span>
                                </div>
                            </div>
                            @if (_model.SelectedLocationId == location.Id)
                            {
                                <div class="check-badge-large">✓</div>
                            }
                        </div>
                    }
                </div>

                @if (_selectedLocation != null && (_selectedLocation.IsPerPerson || _selectedLocation.IsHourly))
                {
                    <div class="line-options mt-4">
                        <h6 class="mb-3">Pricing options for <strong>@_selectedLocation.Name</strong></h6>
                        <div class="line-options-inputs">
                            @if (_selectedLocation.IsPerPerson)
                            {
                                <div class="line-option">
                                    <label>Number of people</label>
                                    <input type="number" min="1" class="form-control"
                                           @bind="_locationPeople" />
                                </div>
                            }
                            @if (_selectedLocation.IsHourly)
                            {
                                <div class="line-option">
                                    <label>Number of hours</label>
                                    <input type="number" min="1" class="form-control"
                                           @bind="_locationHours" />
                                </div>
                            }
                            <div class="line-option line-option-total">
                                <label>Venue total</label>
                                <div class="line-total-value">@GetLocationLineTotal().ToString("N0") RON</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Step 4: Select Products (Grouped by Type) -->
    <div class="step-content @(CurrentStep == 3 ? "active" : "")" style="display: @(CurrentStep == 3 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">🎁</div>
                <h3>Select Services & Products</h3>
            </div>
            <div class="step-card-body">
                <div class="products-by-type">
                    @foreach (var group in _productGroups)
                    {
                        <div class="product-category">
                            <div class="category-header" @onclick="() => ToggleCategoryExpanded(group.TypeName)">
                                <div class="category-toggle">
                                    <i class="bi @(_expandedCategories.Contains(group.TypeName) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </div>
                                <div class="category-info">
                                    <h5 class="category-title">@group.TypeName</h5>
                                    <small class="text-muted">@group.Count items</small>
                                </div>
                            </div>
                            
                            @if (_expandedCategories.Contains(group.TypeName))
                            {
                                <div class="category-products">
                                    @foreach (var product in group.Products)
                                    {
                                        <div class="product-item" title="Company: @product.CompanyName">
                                            <div class="product-info">
                                                <h6 class="product-name">@product.Name</h6>
                                                @if (!string.IsNullOrEmpty(product.CompanyName))
                                                {
                                                    <p class="product-company"><i class="bi bi-building"></i> @product.CompanyName</p>
                                                }
                                                @if (!string.IsNullOrEmpty(product.Description))
                                                {
                                                    <p class="product-description">@product.Description</p>
                                                }
                                                <div class="product-price">
                                                    <span class="price-badge">@product.Price.ToString("N0") RON</span>
                                                </div>
                                            </div>
                                            <div class="product-actions">
                                                @if (IsProductSelected(product.Id))
                                                {

                                                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveProduct(product.Id)">
                                                        Remove
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary btn-add" @onclick="() => AddProduct(product)">
                                                        <i class="bi bi-plus-circle"></i> Add
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (_model.SelectedProducts.Count > 0)
                {
                    <div class="selected-products-summary mt-4">
                        <h6>Selected Items (@_model.SelectedProducts.Count)</h6>
                        <div class="summary-table">
                            @foreach (var product in _model.SelectedProducts)
                            {
                                <div class="summary-row">
                                    <div class="summary-name">
                                        @product.ProductName
                                        @if (!string.IsNullOrEmpty(product.CompanyName))
                                        {
                                            <small class="text-muted d-block">@product.CompanyName</small>
                                        }
                                        <small class="text-muted d-block">
                                            @product.UnitPrice.ToString("N0") RON
                                            @(product.IsPerPerson ? " / person" : "")@(product.IsHourly ? " / hour" : "")
                                        </small>
                                    </div>
                                    @if (product.IsPerPerson || product.IsHourly)
                                    {
                                        <div class="summary-line-inputs">
                                            @if (product.IsPerPerson)
                                            {
                                                <div class="line-option">
                                                    <label>People</label>
                                                    <input type="number" min="1" class="form-control form-control-sm"
                                                           @bind="product.NumberOfPeople" />
                                                </div>
                                            }
                                            @if (product.IsHourly)
                                            {
                                                <div class="line-option">
                                                    <label>Hours</label>
                                                    <input type="number" min="1" class="form-control form-control-sm"
                                                           @bind="product.NumberOfHours" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    <span class="summary-price">@product.LineTotal.ToString("N0") RON</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Step 5: Review and Confirm -->
    <div class="step-content @(CurrentStep == 4 ? "active" : "")" style="display: @(CurrentStep == 4 ? "block" : "none")">
        <div class="step-card">
            <div class="step-card-header">
                <div class="step-icon">✓</div>
                <h3>Review Your Order</h3>
            </div>
            <div class="step-card-body">
                <div class="review-section">
                    <h6 class="review-section-title">Organizer</h6>
                    <p class="review-value">@((_selectedPerson?.FirstName ?? "") + " " + (_selectedPerson?.LastName ?? ""))</p>
                    <small class="text-muted">CNP: @(_selectedPerson?.CNP ?? "Not selected")</small>
                </div>

                <div class="review-section">
                    <h6 class="review-section-title">Event</h6>
                    <p class="review-value">@(_model.EventName ?? "Not specified")</p>
                    <small class="text-muted">Date: @FormatEventDate(_model.EventDate)</small>
                </div>

                <div class="review-section">
                    <h6 class="review-section-title">Venue</h6>
                    <p class="review-value">@(_selectedLocation?.Name ?? "Not selected")</p>
                    @if (_selectedLocation != null)
                    {
                        @if (!string.IsNullOrEmpty(_selectedLocation.CompanyName))
                        {
                            <small class="text-muted d-block">@_selectedLocation.CompanyName</small>
                        }
                        <small class="text-muted d-block">
                            @_selectedLocation.Price.ToString("N0") RON
                            @if (_selectedLocation.IsPerPerson)
                            {
                                <span> × @_locationPeople @(_locationPeople == 1 ? "person" : "people")</span>
                            }
                            @if (_selectedLocation.IsHourly)
                            {
                                <span> × @_locationHours @(_locationHours == 1 ? "hour" : "hours")</span>
                            }
                        </small>
                        <small class="text-muted fw-bold">@GetLocationLineTotal().ToString("N0") RON</small>
                    }
                </div>

                @if (_model.SelectedProducts.Count > 0)
                {
                    <div class="review-section">
                        <h6 class="review-section-title">Services & Products</h6>
                        <div class="review-products">
                            @foreach (var product in _model.SelectedProducts)
                            {
                                <div class="review-product-item">
                                    <span>
                                        @product.ProductName
                                        @if (!string.IsNullOrEmpty(product.CompanyName))
                                        {
                                            <small class="text-muted d-block">@product.CompanyName</small>
                                        }
                                        <small class="text-muted d-block">
                                            @product.UnitPrice.ToString("N0") RON
                                            @if (product.IsPerPerson)
                                            {
                                                <span> × @product.NumberOfPeople @(product.NumberOfPeople == 1 ? "person" : "people")</span>
                                            }
                                            @if (product.IsHourly)
                                            {
                                                <span> × @product.NumberOfHours @(product.NumberOfHours == 1 ? "hour" : "hours")</span>
                                            }
                                        </small>
                                    </span>
                                    <span class="fw-bold">@product.LineTotal.ToString("N0") RON</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="order-total">
                    <span class="total-label">Order Total:</span>
                    <span class="total-amount">@GetOrderTotal().ToString("N0") RON</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="navigation-buttons">
        <button class="btn btn-outline-secondary btn-lg" @onclick="PreviousStep" disabled="@(CurrentStep == 0)">
            <i class="bi bi-arrow-left"></i> Previous
        </button>
        
        @if (CurrentStep < 4)
        {
            <button class="btn btn-primary btn-lg" @onclick="NextStep" disabled="@(!CanProceedToNext())">
                Next <i class="bi bi-arrow-right"></i>
            </button>
        }
        else
        {
            <button class="btn btn-success btn-lg" @onclick="SubmitOrder" disabled="@(_isSubmitting)">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Creating Order</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle"></i> Create Order</span>
                }
            </button>
        }
    </div>
</div>

<style>
    .event-order-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem 0;
    }

    .event-order-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .event-order-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 0.375rem;
        letter-spacing: -0.025em;
    }

    .event-order-subtitle {
        font-size: 0.9375rem;
        color: #64748b;
        margin: 0;
    }

    .progress-wrapper {
        margin-bottom: 2rem;
    }

    .stepper-container {
        display: flex;
        justify-content: center;
        padding: 1.25rem;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 0.875rem;
    }

    .stepper-steps {
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 900px;
        gap: 0;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        position: relative;
        z-index: 1;
    }

    .step-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: white;
        border: 3px solid #d1d5db;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #6b7280;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .step.active .step-circle {
        background: #4f46e5;
        color: white;
        border-color: #4f46e5;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }

    .step.completed .step-circle {
        background: #059669;
        color: white;
        border-color: #059669;
    }

    .step-icon {
        font-size: 1.3rem;
    }

    .step-label {
        margin-top: 12px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #6b7280;
        text-align: center;
        width: 100%;
    }

    .step.active .step-label {
        color: #4f46e5;
        font-weight: 600;
    }

    .step.completed .step-label {
        color: #059669;
    }

    .step-connector {
        flex: 1;
        height: 3px;
        background: #d1d5db;
        margin: 0 8px;
        transition: all 0.3s ease;
        position: relative;
        top: -30px;
    }

    .step-connector.completed {
        background: #059669;
    }

    .step-content {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .step-content.active {
        opacity: 1;
    }

    .step-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 0.875rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
        overflow: visible;
        margin-bottom: 1.5rem;
    }

    .step-card-header {
        background: #f8fafc;
        color: #0f172a;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border-radius: 0.875rem 0.875rem 0 0;
    }

    .step-icon {
        font-size: 2.5rem;
    }

    .step-card-header h3 {
        margin: 0;
        font-size: 1.5rem;
    }

    .step-card-body {
        padding: 30px;
    }

    /* Person Selection */
    .person-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
    }

    .person-card {
        border: 2px solid #ecf0f1;
        border-radius: 10px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        background: white;
    }

    .person-card:hover {
        border-color: #4f46e5;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.08);
    }

    .person-card.selected {
        border-color: #4f46e5;
        background: #eef2ff;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.1);
    }

    .person-card h5 {
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .check-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    /* Location Selection */
    .location-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .location-card {
        border: 2px solid #ecf0f1;
        border-radius: 12px;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        background: white;
    }

    .location-card:hover {
        border-color: #4f46e5;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.08);
    }

    .location-card.selected {
        border-color: #4f46e5;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.12);
    }

    .location-card-inner {
        padding: 20px;
    }

    .location-name {
        margin: 0 0 8px 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .location-company {
        margin: 0 0 8px 0;
        font-size: 0.9rem;
        color: #7f8c8d;
    }

    .location-description {
        margin: 8px 0;
        font-size: 0.85rem;
        color: #95a5a6;
    }

    .location-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #ecf0f1;
    }

    .price-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #6366f1;
    }

    .price-currency {
        font-size: 0.9rem;
        color: #7f8c8d;
    }

    .check-badge-large {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.3rem;
    }

    /* Product Categories */
    .products-by-type {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .product-category {
        border: 1px solid #ecf0f1;
        border-radius: 10px;
        overflow: hidden;
    }

    .category-header {
        background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        padding: 16px 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
        user-select: none;
    }

    .category-header:hover {
        background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
    }

    .category-toggle {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
        transition: transform 0.3s ease;
    }

    .category-info {
