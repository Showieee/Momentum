@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Products</h1>
    </div>

    <div class="page-toolbar">
        <div class="page-search">
            <input type="text" class="form-control" placeholder="Search product..."
                   @bind="_searchText" @oninput="OnSearchInput" />
        </div>
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Add product
        </button>
    </div>

    <div class="page-card">
        @if (_filteredModel.Count == 0)
        {
            <p class="page-empty">No matching records found.</p>
        }
        else
        {
            <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Company</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _filteredModel)
            {
                <tr>
                    <td>@entry.Name</td>
                    <td>
                        <span title="@entry.CompanyName" class="badge bg-info">@GetProductTypeString(entry.Type)</span>
                    </td>
                    <td>
                        <span title="Type: @GetProductTypeString(entry.Type)">@entry.CompanyName</span>
                    </td>
                    <td>
                        @entry.Price.ToString("N0") RON
                        @if (entry.IsPerPerson)
                        {
                            <span class="badge bg-secondary ms-1" title="Per person">/ person</span>
                        }
                        @if (entry.IsHourly)
                        {
                            <span class="badge bg-secondary ms-1" title="Hourly">/ hour</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => OpenEditModal(entry.Id)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(entry.Id)">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
<Modal @ref="_addModal" title="@(_isEditMode ? "Edit Product" : "Add New Product")" IsVerticallyCentered="true" OnHidden="RefreshModalData">
    <BodyTemplate>
        <EditForm EditContext="_editContext">
            <FluentValidator TValidator="IValidator<ProductEntryViewModel>" />
            <div class="mb-3">
                <label class="form-label">Product Name</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Name" />
                <ValidationMessage For="@(() => _newEntry.Name)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Product Type</label>
                <InputSelect class="form-control" @bind-value="_newEntry.Type">
                    <option value="0">Select a type...</option>
                    <option value="1">Location (Accommodation)</option>
                    <option value="2">Food</option>
                    <option value="3">Photography</option>
                    <option value="4">Music</option>
                    <option value="5">Videography</option>
                    <option value="6">Decoration</option>
                    <option value="7">Entertainment</option>
                    <option value="8">Bar</option>
                    <option value="9">Security</option>
                    <option value="10">Cleaning</option>
                    <option value="11">Logistics</option>
                    <option value="12">Transport</option>
                    <option value="13">Print</option>
                </InputSelect>
                <ValidationMessage For="@(() => _newEntry.Type)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Company</label>
                <InputSelect class="form-control" @bind-value="_newEntry.CompanyId">
                    <option value="">Select a company...</option>
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _newEntry.CompanyId)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <InputNumber type="number" class="form-control" @bind-value="_newEntry.Price" step="0.01" />
                <ValidationMessage For="@(() => _newEntry.Price)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Pricing Options</label>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="isPerPerson" @bind-Value="_newEntry.IsPerPerson" />
                    <label class="form-check-label" for="isPerPerson">
                        Per person <small class="text-muted">(price is multiplied by the number of people)</small>
                    </label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="isHourly" @bind-Value="_newEntry.IsHourly" />
                    <label class="form-check-label" for="isHourly">
                        Hourly <small class="text-muted">(price is multiplied by the number of hours)</small>
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-value="_newEntry.Description" />
                <ValidationMessage For="@(() => _newEntry.Description)" class="text-danger" />
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveProduct" disabled="@(!_isValidForm)">
            @(_isEditMode ? "Update" : "Save")
        </button>
    </FooterTemplate>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal @ref="_deleteModal" title="Confirm Deletion" IsVerticallyCentered="true">
    <BodyTemplate>
        <p>Are you sure you want to delete this product?</p>
        <strong>@_selectedProduct.Name</strong>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteProduct">Yes, Delete</button>
    </FooterTemplate>
</Modal>
