@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Events</h1>
    </div>

    <div class="page-toolbar">
        <div class="page-search">
            <input type="text" class="form-control" placeholder="Search event..."
                   @bind="_searchText" @oninput="OnSearchInput" />
        </div>
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Add event
        </button>
    </div>

    <div class="page-card">
        @if (_filteredModel.Count == 0)
        {
            <p class="page-empty">No matching records found.</p>
        }
        else
        {
            <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _filteredModel)
            {
                <tr>
                    <td>@entry.Name</td>
                    <td>@GetEventTypeString(entry.Type)</td>
                    <td>@entry.Date</td>
                    <td>
                        <button class="btn btn-info btn-sm me-2" @onclick="() => OpenInfoModal(entry.Id)" title="View Event Info">
                            <i class="bi bi-info-circle"></i> Info
                        </button>
                        @if (entry.IsPaid)
                        {
                            <button class="btn btn-success btn-sm me-2" disabled title="This order has already been paid">
                                <i class="bi bi-check-circle"></i> Paid
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm me-2" @onclick="() => OpenCheckoutModal(entry.Id)" title="Pay for this order">
                                <i class="bi bi-credit-card"></i> Order
                            </button>
                        }
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => OpenEditModal(entry.Id)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(entry.Id)">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
<Modal @ref="_addModal" title="@(_isEditMode ? "Edit Event" : "Add New Event")" IsVerticallyCentered="true" OnHidden="RefreshModalData">
    <BodyTemplate>
        <EditForm EditContext="_editContext">
            <FluentValidator TValidator="IValidator<EventEntryViewModel>" />
            <div class="mb-3">
                <label class="form-label">Event Name</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Name" />
                <ValidationMessage For="@(() => _newEntry.Name)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Event Type</label>
                <InputSelect class="form-control" @bind-value="_newEntry.Type">
                    <option value="0">Select a type...</option>
                    <option value="1">Wedding</option>
                    <option value="2">Birthday</option>
                    <option value="3">Teambuilding</option>
                    <option value="4">Festival</option>
                    <option value="5">Other</option>
                    <option value="6">Meeting</option>
                    <option value="7">Party</option>
                    <option value="8">Community</option>
                    <option value="9">Conference</option>
                    <option value="10">Gala</option>
                    <option value="11">Product Launch</option>
                    <option value="12">Baby Shower</option>
                </InputSelect>
                <ValidationMessage For="@(() => _newEntry.Type)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Date (YYYY-MM-DD)</label>
                <InputText type="date" class="form-control" @bind-value="_newEntry.Date" />
                <ValidationMessage For="@(() => _newEntry.Date)" class="text-danger" />
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveEvent" disabled="@(!_isValidForm)">
            @(_isEditMode ? "Update" : "Save")
        </button>
    </FooterTemplate>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal @ref="_deleteModal" title="Confirm Deletion" IsVerticallyCentered="true">
    <BodyTemplate>
        <p>Are you sure you want to delete this event?</p>
        <strong>@_selectedEvent.Name</strong>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteEvent">Yes, Delete</button>
    </FooterTemplate>
</Modal>

<!-- Event Info Modal -->
<Modal @ref="_infoModal" title="Event Information" IsVerticallyCentered="true" Size="ModalSize.Large">
    <BodyTemplate>
        @if (_selectedEvent.Id != Guid.Empty)
        {
            <div class="event-info-container">
                <div class="info-section">
                    <h6 class="info-section-title">Event Details</h6>
                    <div class="info-row">
                        <span class="info-label">Name:</span>
                        <span class="info-value">@_selectedEvent.Name</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Type:</span>
                        <span class="info-value">@GetEventTypeString(_selectedEvent.Type)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Date:</span>
                        <span class="info-value">@_selectedEvent.Date</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedEvent.LocationName))
                {
                    <div class="info-section">
                        <h6 class="info-section-title">Venue</h6>
                        <div class="info-row">
                            <span class="info-label">Location:</span>
                            <span class="info-value">@_selectedEvent.LocationName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Price:</span>
                            <span class="info-value">
                                @_selectedEvent.LocationLineTotal.ToString("N0") RON
                                @if (_selectedEvent.LocationIsPerPerson || _selectedEvent.LocationIsHourly)
                                {
                                    <small class="text-muted d-block">
                                        @_selectedEvent.LocationPrice.ToString("N0") RON@(_selectedEvent.LocationIsPerPerson ? $" × {_selectedEvent.LocationPeople} people" : "")@(_selectedEvent.LocationIsHourly ? $" × {_selectedEvent.LocationHours} hours" : "")
                                    </small>
                                }
                            </span>
                        </div>
                    </div>
                }

                @if (_selectedEvent.SelectedProducts.Count > 0)
                {
                    <div class="info-section">
                        <h6 class="info-section-title">Services & Products</h6>
                        <div class="products-list">
                            @foreach (var product in _selectedEvent.SelectedProducts)
                            {
                                <div class="product-info-item">
                                    <span class="product-name">
                                        @product.ProductName
                                        @if (product.IsPerPerson || product.IsHourly)
                                        {
                                            <small class="text-muted d-block">
                                                @product.Price.ToString("N0") RON@(product.IsPerPerson ? $" × {product.NumberOfPeople} people" : "")@(product.IsHourly ? $" × {product.NumberOfHours} hours" : "")
                                            </small>
                                        }
                                    </span>
                                    <span class="product-price">@product.LineTotal.ToString("N0") RON</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="info-section total-section">
                    <div class="info-row total-row">
                        <span class="info-label">Total Price:</span>
                        <span class="total-value">@_selectedEvent.TotalPrice.ToString("N0") RON</span>
                    </div>
                </div>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseInfoModal">Close</button>
    </FooterTemplate>
</Modal>

<!-- Edit Event Modal (Combined: Event Details + Venue & Products) -->
<Modal @ref="_editEventModal" title="Edit Event" IsVerticallyCentered="true" Size="ModalSize.Large" OnHidden="RefreshEditEventModalData">
    <BodyTemplate>
        @if (_editEventEntry != null)
        {
            <div class="edit-event-full-container">
                <!-- Event Details Section -->
                <div class="event-details-section">
                    <h6 class="section-title">Event Details</h6>
                    <EditForm EditContext="_editEventDetailsContext">
                        <FluentValidator TValidator="IValidator<EventEntryViewModel>" />
                        <div class="mb-3">
                            <label class="form-label">Event Name</label>
                            <InputText type="text" class="form-control" @bind-value="_editEventEntry.Name" />
                            <ValidationMessage For="@(() => _editEventEntry.Name)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Event Type</label>
                            <InputSelect class="form-control" @bind-value="_editEventEntry.Type">
                                <option value="0">Select a type...</option>
                                <option value="1">Wedding</option>
                                <option value="2">Birthday</option>
                                <option value="3">Teambuilding</option>
                                <option value="4">Festival</option>
                                <option value="5">Other</option>
                                <option value="6">Meeting</option>
                                <option value="7">Party</option>
                                <option value="8">Community</option>
                                <option value="9">Conference</option>
                                <option value="10">Gala</option>
                                <option value="11">Product Launch</option>
                                <option value="12">Baby Shower</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _editEventEntry.Type)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Date (YYYY-MM-DD)</label>
                            <InputText type="date" class="form-control" @bind-value="_editEventEntry.Date" />
                            <ValidationMessage For="@(() => _editEventEntry.Date)" class="text-danger" />
                        </div>
                    </EditForm>
                </div>

                <!-- Venue & Products Section -->
                @if (_availableLocationsForEdit != null && _availableProductsForEdit != null)
                {
                    <div class="venue-products-section">
                        <h6 class="section-title">Select Venue</h6>
                        <div class="locations-grid">
                            @foreach (var location in _availableLocationsForEdit)
                            {
                                <div class="location-card @(_editEventEntry.SelectedLocationId == location.Id ? "selected" : "")"
                                     @onclick="() => SelectEditLocation(location.Id)">
                                    <div class="location-info">
                                        <h6>@location.Name</h6>
                                        <p class="text-muted mb-0">
                                            @location.Price.ToString("N0") RON
                                            @(location.IsPerPerson ? " / person" : "")@(location.IsHourly ? " / hour" : "")
                                        </p>
                                    </div>
                                    @if (_editEventEntry.SelectedLocationId == location.Id)
                                    {
                                        <div class="check-badge">✓</div>
                                    }
                                </div>
                            }
                        </div>

                        @{
                            var editVenue = GetEditSelectedLocation();
                        }
                        @if (editVenue != null && (editVenue.IsPerPerson || editVenue.IsHourly))
                        {
                            <div class="line-options mt-3">
                                <h6 class="mb-2">Pricing options for <strong>@editVenue.Name</strong></h6>
                                <div class="line-options-inputs">
                                    @if (editVenue.IsPerPerson)
                                    {
                                        <div class="line-option">
                                            <label>Number of people</label>
                                            <input type="number" min="1" class="form-control form-control-sm"
                                                   @bind="_editLocationPeople" />
                                        </div>
                                    }
                                    @if (editVenue.IsHourly)
                                    {
                                        <div class="line-option">
                                            <label>Number of hours</label>
                                            <input type="number" min="1" class="form-control form-control-sm"
                                                   @bind="_editLocationHours" />
                                        </div>
                                    }
                                    <div class="line-option line-option-total">
                                        <label>Venue total</label>
                                        <div class="line-total-value">@GetEditLocationLineTotal().ToString("N0") RON</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <h6 class="section-title mt-4">Select Services & Products</h6>
                        <div class="products-selection">
                            @foreach (var product in _availableProductsForEdit)
                            {
                                <div class="product-selection-item">
                                    <div class="form-check form-check-custom">
                                        <input type="checkbox" class="form-check-input" id="product_@product.Id"
                                               @onchange="e => UpdateProductSelection(product.Id, (bool)e.Value!)" 
                                               checked="@_editEventEntry.SelectedProductIds.Contains(product.Id)" />
                                        <label class="form-check-label" for="product_@product.Id">
                                            <span class="product-name">
                                                @product.Name
                                                @(product.IsPerPerson ? " / person" : "")@(product.IsHourly ? " / hour" : "")
                                            </span>
                                            <span class="product-type">@GetProductTypeString(product.Type)</span>
                                            <span class="product-price">@product.Price.ToString("N0") RON</span>
                                        </label>
                                    </div>
                                    @if (_editEventEntry.SelectedProductIds.Contains(product.Id) && (product.IsPerPerson || product.IsHourly))
                                    {
                                        <div class="line-options-inputs mt-2">
                                            @if (product.IsPerPerson)
                                            {
                                                <div class="line-option">
                                                    <label>People</label>
                                                    <input type="number" min="1" class="form-control form-control-sm"
                                                           @bind="product.NumberOfPeople" />
                                                </div>
                                            }
                                            @if (product.IsHourly)
                                            {
                                                <div class="line-option">
                                                    <label>Hours</label>
                                                    <input type="number" min="1" class="form-control form-control-sm"
                                                           @bind="product.NumberOfHours" />
                                                </div>
                                            }
                                            <div class="line-option line-option-total">
                                                <label>Line total</label>
                                                <div class="line-total-value">@GetProductLineTotal(product).ToString("N0") RON</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Edit Modal Total Price -->
                        <div class="edit-modal-total-section mt-4">
                            <div class="edit-modal-total-row">
                                <span class="edit-total-label">Total Price:</span>
                                <span class="edit-total-amount">@GetEditModalTotalPrice().ToString("N0") RON</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseEditEventModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveEditEventComplete">Save All Changes</button>
    </FooterTemplate>
</Modal>

<!-- Checkout Modal -->
<Modal @ref="_checkoutModal" title="Checkout" IsVerticallyCentered="true" OnHidden="RefreshCheckoutModalData">
    <BodyTemplate>
        <div class="checkout-container">
            <div class="checkout-summary">
                <div class="checkout-summary-row">
                    <span class="checkout-event-name">@_selectedEvent.Name</span>
                </div>
                <div class="checkout-summary-row checkout-total-row">
                    <span>Amount due</span>
                    <span class="checkout-amount">@_selectedEvent.TotalPrice.ToString("N0") RON</span>
                </div>
            </div>

            <div class="checkout-card-badge">
                <i class="bi bi-credit-card-2-front"></i>
                <span>Card payment only</span>
            </div>

            <EditForm EditContext="_checkoutContext">
                <FluentValidator TValidator="IValidator<CheckoutViewModel>" />
                <div class="mb-3">
                    <label class="form-label">Cardholder Name</label>
                    <InputText class="form-control" placeholder="Name on card" @bind-value="_checkout.CardholderName" />
                    <ValidationMessage For="@(() => _checkout.CardholderName)" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Card Number</label>
                    <InputText class="form-control" placeholder="1234 5678 9012 3456" autocomplete="off" @bind-value="_checkout.CardNumber" />
                    <ValidationMessage For="@(() => _checkout.CardNumber)" class="text-danger" />
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Expiry (MM/YY)</label>
                        <InputText class="form-control" placeholder="MM/YY" autocomplete="off" @bind-value="_checkout.Expiry" />
                        <ValidationMessage For="@(() => _checkout.Expiry)" class="text-danger" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">CVC</label>
                        <InputText class="form-control" placeholder="123" autocomplete="off" @bind-value="_checkout.Cvc" />
                        <ValidationMessage For="@(() => _checkout.Cvc)" class="text-danger" />
                    </div>
                </div>
            </EditForm>

            <p class="checkout-disclaimer">
                <i class="bi bi-shield-lock"></i>
                Your card details are used only to complete this payment and are never stored.
            </p>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseCheckoutModal" disabled="@_isProcessingPayment">Cancel</button>
        <button class="btn btn-primary" @onclick="ProcessPayment" disabled="@(!_isCheckoutValid || _isProcessingPayment)">
            @if (_isProcessingPayment)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Pay @_selectedEvent.TotalPrice.ToString("N0") RON</span>
            }
        </button>
    </FooterTemplate>
</Modal>

<style>
    /* Checkout Modal Styles */
    .checkout-container {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .checkout-summary {
        background: #f9fafb;
        border-radius: 8px;
        padding: 16px;
        border-left: 3px solid #6366f1;
    }

    .checkout-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .checkout-event-name {
        font-weight: 600;
        color: #1f2937;
    }

    .checkout-total-row {
        margin-top: 8px;
        color: #6b7280;
        font-weight: 600;
    }

    .checkout-amount {
        color: #6366f1;
        font-weight: 700;
        font-size: 1.25rem;
    }

    .checkout-card-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #6b7280;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .checkout-disclaimer {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #9ca3af;
        margin: 0;
    }

    /* Event Info Modal Styles */
    .event-info-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-section {
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 16px;
    }

    .info-section:last-child {
        border-bottom: none;
    }

    .info-section-title {
        color: #6b7280;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
    }

    .info-label {
        color: #6b7280;
        font-weight: 600;
        min-width: 120px;
    }

    .info-value {
        color: #1f2937;
        font-weight: 500;
    }

    .products-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .product-info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        background: #f9fafb;
        border-radius: 6px;
        border-left: 3px solid #6366f1;
    }

    .product-name {
        color: #1f2937;
        font-weight: 500;
    }

    .product-price {
        color: #6366f1;
        font-weight: 600;
    }

    .total-section {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        padding: 16px;
        border-radius: 8px;
        border-bottom: none;
        margin-bottom: 0;
    }

    .total-row {
        padding: 0;
    }

    .total-row .info-label {
        color: rgba(255, 255, 255, 0.9);
    }

    .total-value {
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
    }

    /* Edit Event Modal Styles */
    .edit-event-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-title {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .locations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
    }

    .location-card {
        border: 2px solid #d1d5db;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        background: white;
    }

    .location-card:hover {
        border-color: #6366f1;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
    }

    .location-card.selected {
        border-color: #6366f1;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .location-info h6 {
        margin-bottom: 8px;
        color: #1f2937;
    }

    .check-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 28px;
        height: 28px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .products-selection {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 400px;
        overflow-y: auto;
    }

    .product-selection-item {
        padding: 12px;
        background: #f9fafb;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

    .product-selection-item:hover {
        background: #f3f4f6;
        border-color: #d1d5db;
    }

    .form-check-custom {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .form-check-custom .form-check-input {
        margin: 0;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .form-check-custom .form-check-label {
        margin: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex: 1;
        cursor: pointer;
    }

    .form-check-custom .product-name {
        color: #1f2937;
        font-weight: 500;
    }

    .form-check-custom .product-type {
        color: #9ca3af;
        font-size: 0.85rem;
        margin: 0 8px;
    }

    .form-check-custom .product-price {
        color: #6366f1;
        font-weight: 600;
        min-width: 100px;
        text-align: right;
    }

    /* Combined Edit Event Modal Styles */
    .edit-event-full-container {
        display: flex;
        flex-direction: column;
        gap: 32px;
        max-height: 70vh;
        overflow-y: auto;
        padding-right: 8px;
    }

    .event-details-section {
        border-bottom: 2px solid #e5e7eb;
        padding-bottom: 24px;
    }

    .event-details-section .section-title {
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #d1d5db;
    }

    .venue-products-section {
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding-top: 16px;
    }

    .edit-modal-total-section {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        padding: 16px;
        border-radius: 8px;
        margin-top: 16px;
    }

    .edit-modal-total-row {
        display: flex;
        justify-content: space-between;
