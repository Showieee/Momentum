@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<h3>Events Management</h3>

<!-- Search Field -->
<div class="mb-3">
    <input type="text" class="form-control" placeholder="Search event..."
           @bind="_searchText" @oninput="OnSearchInput" />
</div>

<!-- Add Button -->
<button class="btn btn-primary mb-3" @onclick="OpenAddModal">
    <i class="bi bi-plus-circle"></i> Add New Event
</button>

<!-- Display Events Table -->
@if (_filteredModel.Count == 0)
{
    <p>No matching records found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _filteredModel)
            {
                <tr>
                    <td>@entry.Name</td>
                    <td>@entry.Type</td>
                    <td>@entry.Date</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => OpenEditModal(entry.Id)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(entry.Id)">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Add/Edit Modal -->
<Modal @ref="_addModal" title="@(_isEditMode ? "Edit Event" : "Add New Event")" IsVerticallyCentered="true" OnHidden="RefreshModalData">
    <BodyTemplate>
        <EditForm EditContext="_editContext">
            <FluentValidator TValidator="IValidator<EventEntryViewModel>" />
            <div class="mb-3">
                <label class="form-label">Event Name</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Name" />
                <ValidationMessage For="@(() => _newEntry.Name)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Event Type</label>
                <InputSelect class="form-control" @bind-value="_newEntry.Type">
                    <option value="0">Select a type...</option>
                    <option value="1">Wedding</option>
                    <option value="2">Birthday</option>
                    <option value="3">Teambuilding</option>
                    <option value="4">Festival</option>
                </InputSelect>
                <ValidationMessage For="@(() => _newEntry.Type)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Date (YYYY-MM-DD)</label>
                <InputText type="date" class="form-control" @bind-value="_newEntry.Date" />
                <ValidationMessage For="@(() => _newEntry.Date)" class="text-danger" />
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveEvent" disabled="@(!_isValidForm)">
            @(_isEditMode ? "Update" : "Save")
        </button>
    </FooterTemplate>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal @ref="_deleteModal" title="Confirm Deletion" IsVerticallyCentered="true">
    <BodyTemplate>
        <p>Are you sure you want to delete this event?</p>
        <strong>@_selectedEvent.Name</strong>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteEvent">Yes, Delete</button>
    </FooterTemplate>
</Modal>
