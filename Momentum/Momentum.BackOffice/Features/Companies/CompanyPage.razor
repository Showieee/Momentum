@inherits ExtendedComponentBase
@attribute [Authorize(Roles = "Administrator, Manager")]

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Companies</h1>
    </div>

    <div class="page-toolbar">
        <div class="page-search">
            <input type="text" class="form-control" placeholder="Search company..."
                   @bind="_searchText" @oninput="OnSearchInput" />
        </div>
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Add company
        </button>
    </div>

    <div class="page-card">
        @if (_filteredModel.Count == 0)
        {
            <p class="page-empty">No matching records found.</p>
        }
        else
        {
            <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>CUI</th>
                <th>City</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _filteredModel)
            {
                <tr>
                    <td>@entry.Name</td>
                    <td>@entry.CUI</td>
                    <td>@entry.Address?.City</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => OpenEditModal(entry.Id)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(entry.Id)">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
<Modal @ref="_addModal" title="@(_isEditMode ? "Edit Company" : "Add New Company")" IsVerticallyCentered="true" OnHidden="RefreshModalData">
    <BodyTemplate>
        <EditForm EditContext="_editContext">
            <FluentValidator TValidator="IValidator<CompanyEntryViewModel>" />
            <div class="mb-3">
                <label class="form-label">Company Name</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Name" />
                <ValidationMessage For="@(() => _newEntry.Name)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">CUI</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.CUI" />
                <ValidationMessage For="@(() => _newEntry.CUI)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Street Name</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.StreetName" />
                <ValidationMessage For="@(() => _newEntry.Address.StreetName)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Street Number</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.StreetNumber" />
                <ValidationMessage For="@(() => _newEntry.Address.StreetNumber)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">City</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.City" />
                <ValidationMessage For="@(() => _newEntry.Address.City)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">State</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.State" />
                <ValidationMessage For="@(() => _newEntry.Address.State)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Country</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.Country" />
                <ValidationMessage For="@(() => _newEntry.Address.Country)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.Email" />
                <ValidationMessage For="@(() => _newEntry.Address.Email)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <InputText type="text" class="form-control" @bind-value="_newEntry.Address!.PhoneNumber" />
                <ValidationMessage For="@(() => _newEntry.Address.PhoneNumber)" class="text-danger" />
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveCompany" disabled="@(!_isValidForm)">
            @(_isEditMode ? "Update" : "Save")
        </button>
    </FooterTemplate>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal @ref="_deleteModal" title="Confirm Deletion" IsVerticallyCentered="true">
    <BodyTemplate>
        <p>Are you sure you want to delete this company?</p>
        <strong>@_selectedCompany.Name</strong>
        <strong>@($"CUI: {_selectedCompany.CUI}")</strong>
    </BodyTemplate>
    <FooterTemplate>
        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteCompany">Yes, Delete</button>
    </FooterTemplate>
</Modal>
